<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alden</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <form method="get" action="/chats/new">
        <button id="btn">New chat</button>
    </form>
    <br><br>
  
    <div class="top_s"></div>
    <%  for (let i=0; i < chats.length ;i++){ %>
<!-- Math.floor(Math.random() *i )+1 -->
      <%  let chat = chats[i]; %>
  
    <br><br>
        <div class="chats">
          

            <p class="from"> From : <i>
                    <%= chat.from %>
                </i> </p>
            <hr>
            <p class="message"> Message :  <%= chat.message %> <br>
            </p>
            <!-- <p> Recieved by :<i><%#  chat.to %> </i> </p> -->
             <form method="get" action="/chats/<%= chat.id %>/edit">
                <button class="edit_btn">Edit</button>
             </form>

             <br>

            <form action="/chats/<%= chat._id %>?_method=DELETE" method="POST">
                <button type="submit" class="edit_btn">Delete</button>
            </form>


           



            <p class="date">
                <%= chat .created_at.toString().split(' ')[4] %></p>
         <p class="date"> <%= chat .created_at.toString().split(' ').slice(0,4).join(' ') %></p>
         

    </div>

     <% } %>

 
</body>
<script>
  // Wait for the page to load
  window.onload = function () {
    // Scroll smoothly to the bottom of the page
    window.scrollTo({
      top: document.body.scrollHeight,
      behavior:"smooth"
    });
  };
</script>
</html>