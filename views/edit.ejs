<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit </title>
     <style>
        input{
            width: 90%;
            height: auto;
        }
        button{
            width: 40%;
            height: 50px;
        }
        label{
            font-size: larger;
        }
    </style>
</head>
<body>
    <h1>Editting your message</h1>
    <form action="/chats/<%= chat_._id %>?_method=PUT" method="POST">
        <label>Message:</label><br><br>
        <input type="text" name="message" value="<%= chat_.message %>" required><br><br>
        <button type="submit">Update Chat</button>

    </form>

  

</body>
</html>